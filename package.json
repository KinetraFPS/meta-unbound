{
  "name": "meta-unbound",
  "version": "0.1.0",
  "description": "Deadlock and Overwatch meta auditor: patch-aware tiers, builds, matchups and maps.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node src/build.js",
    "offline": "node src/build.js --offline",
    "patch": "node src/build.js --patch",
    "serve": "node src/serve.js",
    "pages": "node src/build.js && node overwatch/build.js && node src/pages.js",
    "build:ow": "node overwatch/build.js",
    "counters": "node overwatch/counters.js",
    "start": "node src/local.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  }
}
